# ── Logs (dev-mode log files; production logs go to OS-specific paths) ────────
logs/

# ── Go ────────────────────────────────────────────────────────────────────────
build/bin/
frontend/package.json.md5
temp.txt
*.exe
*.test
*.out
coverage.out
*.tmp          # atomic-write temp files produced by the DDL exporter

# ── Compiled app binary (produced by `wails build` / `go build`) ──────────────
/thaw
/frontend/thaw

# ── Wails build artefacts ─────────────────────────────────────────────────────
/.task/
/build/darwin/thaw.app
/build/darwin/icons.icns
/build/windows/thaw.exe
# Regenerated by `wails3 task windows:*` from build/config.yml — never commit these.
# (project.nsi and installer/resources/ ARE tracked; everything below is generated.)
/build/windows/icon.ico
/build/windows/info.json
/build/windows/wails.exe.manifest
/build/windows/.assets-tmp/
/build/windows/*.syso
/wails_windows_*.syso
/build/windows/installer/wails_tools.nsh
/build/windows/installer/MicrosoftEdgeWebview2Setup.exe
/build/windows/installer/tmp/

# ── Frontend ──────────────────────────────────────────────────────────────────
frontend/node_modules/
frontend/dist/*
!frontend/dist/.gitkeep

# ── Credentials / environment ─────────────────────────────────────────────────
.env
.env.*
!.env.example    # allow a committed example file

# ── OS ────────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── IDE / tooling ─────────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo

# ── Generated documentation (source files in docs/ are tracked; output is not) ─
/docs/frontend/
/docs/backend/

# ── Claude Code (local session state — not project files) ─────────────────────
.claude/

# ── Release toolchain ─────────────────────────────────────────────────────────
node_modules/

# Vector DB
.chroma_db/
scripts/.venv/
